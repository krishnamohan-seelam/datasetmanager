# Copy to .env for local development. .env is gitignored.
# In any non-development APP_ENV, Settings fails startup if the secret
# fields below are left empty or set to one of these placeholder values —
# see app/core/config.py.

APP_ENV=development

# Database
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=dataset_manager

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / Storage (dev-only credentials — never reuse these outside development)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=dataset-manager-storage
MINIO_SECURE=False

# Security (dev-only secrets — generate real ones for any shared/deployed environment)
SECRET_KEY=your-secret-key
JWT_SECRET_KEY=your-secret-key-for-local-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Uploads
MAX_UPLOAD_SIZE_BYTES=10737418240
